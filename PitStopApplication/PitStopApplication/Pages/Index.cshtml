@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Predict a Pitstop</h1>
    <form method="post">
        <div>
            <label asp-for="Input.Compound"></label>
            <select asp-for="Input.Compound">
                <option>SOFT</option>
                <option>MEDIUM</option>
                <option>HARD</option>
                <option>INTERMEDIATE</option>
                <option>WET</option>
            </select>
        
            <label asp-for="Input.Year"></label>
            <select asp-for="Input.Year">
                <option>2022</option>
                <option>2023</option>
                <option>2024</option>
                <option>2025</option>
            </select>
        </div>
        
        <div>
            <label asp-for="Input.LapNumber"></label>
            <input asp-for="Input.LapNumber" type="number" step="any" />
        
            <label asp-for="Input.TotalLaps"></label>
            <input asp-for="Input.TotalLaps" type="number" step="any" />
        
            <label asp-for="Input.TyreLife"></label>
            <input asp-for="Input.TyreLife" type="number" step="any" />
        </div>
        
        <div>
            <label asp-for="Input.Position"></label>
            <input asp-for="Input.Position" type="number" step="any" />
        
            <label asp-for="Input.Position_Change"></label>
            <input asp-for="Input.Position_Change" type="number" step="any" />
        
            <label asp-for="Input.PitStop"></label>
            <input asp-for="Input.PitStop" type="number" step="any" />
        
            <label asp-for="Input.Stint"></label>
            <input asp-for="Input.Stint" type="number" step="any" />
        </div>
        

        <button type="submit">Predict</button>
    </form>

    @if (Model.Result != null)
    {
        <h2>Prediction</h2>
        <p>Predicted pit next lap: @(Model.PredictedPitstop == true ? "Yes" : "No")</p>
        <p>Probability: @Model.Result.Probability.ToString("P1")</p>
    }
</div>
